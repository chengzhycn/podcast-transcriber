# ── STT Provider ─────────────────────────────────────────────────────────────
# 可选：local | openai
STT_PROVIDER=local

# Local FunASR (Docker on Mac) — 推荐，中文准确率最高，带说话人区分
# 启动：docker compose -f docker-compose.funasr.yml up -d
ASR_LOCAL_URL=http://localhost:18902

# ── LLM (blog writing) ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# 留空则用官方 api.openai.com；国内代理或本地 LLM 填 base_url
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
