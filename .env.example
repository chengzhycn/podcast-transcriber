# Aliyun ASR (primary STT)
# 开通步骤：阿里云控制台 → 产品 → 智能语音交互 → 创建项目
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_APPKEY=

# OpenAI (blog organization + Whisper fallback)
OPENAI_API_KEY=sk-...

# Output directory (default: ./output)
OUTPUT_DIR=./output

# Default LLM model for blog writing (default: gpt-4o)
# Cheaper option: gpt-4o-mini
LLM_MODEL=gpt-4o
