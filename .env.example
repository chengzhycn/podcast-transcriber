# ── STT Provider ─────────────────────────────────────────────────────────────
# 可选：local | self-hosted | openai
STT_PROVIDER=local

# Local FunASR (Docker on Mac) — 推荐，中文准确率最高，带说话人区分
# 启动：docker compose -f docker-compose.funasr.yml up -d
ASR_LOCAL_URL=http://localhost:18902

# Self-hosted faster-whisper-server (云服务器 SSH 方案，备选)
# 服务器通过 SSH 直接从 CDN 下载音频转录，避免本地上传带宽瓶颈
ASR_SSH_HOST=<your-server-ip>
ASR_SSH_KEY=~/.ssh/your-key.pem
ASR_SSH_USER=root
ASR_PORT=18900
ASR_MODEL=Systran/faster-whisper-tiny

# ── LLM (blog writing) ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# 留空则用官方 api.openai.com；国内代理或本地 LLM 填 base_url
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
