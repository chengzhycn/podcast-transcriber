# Self-hosted faster-whisper-server (primary STT)
# 服务器通过 SSH 直接从 CDN 下载音频转录，避免本地上传带宽瓶颈
ASR_SSH_HOST=<your-server-ip>
ASR_SSH_KEY=~/.ssh/your-key.pem   # SSH 私钥路径
ASR_SSH_USER=root
ASR_PORT=18900                     # 宿主机映射端口（docker -p 18900:8000 中的 18900）
ASR_MODEL=Systran/faster-whisper-tiny

# OpenAI (blog organization + optional cloud Whisper fallback)
OPENAI_API_KEY=sk-...
# 自定义接口地址（留空则用官方 api.openai.com）
# 例：国内代理 https://api.your-proxy.com/v1，或本地 LLM http://localhost:11434/v1
OPENAI_BASE_URL=

# Output directory (default: ./output)
OUTPUT_DIR=./output

# Default LLM model for blog writing (default: gpt-4o)
LLM_MODEL=gpt-4o
